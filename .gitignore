.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IntelliJ's own compiler output (separate from Gradle's build/) when the IDE is set to build/run
# the project itself rather than delegating to Gradle — lands in bin/main, bin/test.
bin/

.idea/
*.iml
*.iws
*.ipr
out/
.vscode/

# Local config for the Serena coding-assistant tool (LSP-based code navigation) — personal tooling
# state, not part of the app.
.serena/

.env
.env.local
*.log

# Claude Code: keep shared commands, ignore local-only settings
.claude/settings.local.json

# Auto-downloaded by the downloadPdfFonts Gradle task
src/main/resources/fonts/

# Local file storage (logos and other uploads)
data/

.DS_Store
Thumbs.db
